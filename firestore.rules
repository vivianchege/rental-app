rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed data model: app records live under artifacts/{appId}/public/data/{collection}/{id}.
    // payments: tenant/cycle IDs, amount allocations, type/method/reference, status, date, actor and workspace.
    // billingCycles: mirrored ID, month/year/index, OPEN/CLOSED state, timestamps, actor and workspace.
    // tenantCycles: tenant/cycle IDs, expected/paid rent and water, status, creation actor/time and workspace.
    // Other operational collections retain the existing app schema and workspace/actor checks.

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    // Temporary compatibility bridge for the three existing production accounts.
    function isLegacyLandlord() {
      return signedIn() && request.auth.uid == 'b4HMBcL0WXT3Qg2vunj5ITZOVb72';
    }

    function isLegacyManager() {
      return signedIn() && request.auth.uid in [
        'CG6wl2NaTcdLHyGlXHk4w9eCU653',
        'N8wEpIJvUZRmD6WoYYxqpUiiLhj2'
      ];
    }

    function isLegacyAccount() {
      return isLegacyLandlord() || isLegacyManager();
    }

    function profile() {
      return get(profilePath()).data;
    }

    function isLandlord() {
      return signedIn() && (
        request.auth.token.role == 'LANDLORD' ||
        isLegacyLandlord() ||
        (hasProfile() && profile().role == 'LANDLORD')
      );
    }

    function isManager() {
      return signedIn() && (
        request.auth.token.role == 'MANAGER' ||
        isLegacyManager() ||
        (hasProfile() && profile().role == 'MANAGER')
      );
    }

    function sameWorkspace(data) {
      return data.workspaceId is string && (
        (hasProfile() && profile().workspaceId is string && data.workspaceId == profile().workspaceId) ||
        (isLegacyAccount() && data.workspaceId == 'main-workspace')
      );
    }

    function legacyRecord(data) {
      return isLegacyAccount() && (!(data.workspaceId is string) || data.workspaceId == 'main-workspace');
    }

    function managerCollectionAllowed(collectionName) {
      return collectionName in [
        'houses', 'tenants', 'payments', 'repairs', 'septicLogs', 'masterWaterBills',
        'billingCycles', 'tenantCycles', 'expenses', 'notifications', 'paymentReferences'
      ];
    }

    function managerCanCreate(collectionName) {
      return collectionName in [
        'payments', 'repairs', 'septicLogs', 'masterWaterBills', 'expenses',
        'notifications', 'paymentReferences', 'auditLogs'
      ];
    }

    function paymentCycleIsOpen(appId, paymentData) {
      let tenantCycleId = paymentData.tenantId + '_' + paymentData.cycleId;
      let billingCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/billingCycles/$(paymentData.cycleId);
      let tenantCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenantCycles/$(tenantCycleId);
      let tenantPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenants/$(paymentData.tenantId);
      return exists(billingCyclePath) &&
        get(billingCyclePath).data.status == 'OPEN' &&
        sameWorkspace(get(billingCyclePath).data) &&
        exists(tenantPath) &&
        sameWorkspace(get(tenantPath).data) &&
        exists(tenantCyclePath) &&
        get(tenantCyclePath).data.tenantId == paymentData.tenantId &&
        get(tenantCyclePath).data.cycleId == paymentData.cycleId &&
        sameWorkspace(get(tenantCyclePath).data);
    }

    function isValidPayment(data) {
      return data.keys().hasAll([
          'tenantId', 'tenantName', 'amount', 'appliedRent', 'appliedWater', 'excessAmount',
          'type', 'method', 'messageCode', 'status', 'date', 'loggedBy', 'cycleId', 'workspaceId', 'createdBy'
        ]) &&
        data.keys().hasOnly([
          'tenantId', 'tenantName', 'amount', 'appliedRent', 'appliedWater', 'excessAmount',
          'type', 'method', 'messageCode', 'status', 'date', 'loggedBy', 'cycleId', 'workspaceId', 'createdBy', 'updatedBy'
        ]) &&
        data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128 &&
        data.tenantName is string && data.tenantName.size() > 0 && data.tenantName.size() <= 120 &&
        data.amount is number && data.amount > 0 && data.amount <= 1000000000000 &&
        data.appliedRent is number && data.appliedRent >= 0 && data.appliedRent <= data.amount &&
        data.appliedWater is number && data.appliedWater >= 0 && data.appliedWater <= data.amount &&
        data.excessAmount is number && data.excessAmount >= 0 && data.excessAmount <= data.amount &&
        data.type in ['RENT', 'WATER', 'COMBINED'] &&
        data.method is string && data.method.size() > 0 && data.method.size() <= 40 &&
        data.messageCode is string && data.messageCode.size() <= 100 &&
        data.status in ['PENDING', 'CONFIRMED'] &&
        data.date is string && data.date.size() > 0 && data.date.size() <= 40 &&
        data.loggedBy in ['LANDLORD', 'MANAGER'] &&
        data.cycleId is string && data.cycleId.size() > 0 && data.cycleId.size() <= 128 &&
        data.workspaceId is string && data.workspaceId.size() > 0 && data.workspaceId.size() <= 120 &&
        data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128 &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128)) &&
        ((data.status == 'PENDING' && data.loggedBy == 'MANAGER' &&
          data.appliedRent == 0 && data.appliedWater == 0 && data.excessAmount == 0) ||
         (data.status == 'CONFIRMED' &&
          math.abs(data.amount - data.appliedRent - data.appliedWater - data.excessAmount) <= 0.01));
    }

    function isValidBillingCycle(data, recordId) {
      return data.keys().hasAll([
          'id', 'month', 'year', 'monthIndex', 'status', 'openedAt', 'closedAt',
          'openedBy', 'workspaceId', 'createdBy'
        ]) &&
        data.keys().hasOnly([
          'id', 'month', 'year', 'monthIndex', 'status', 'openedAt', 'closedAt',
          'openedBy', 'workspaceId', 'createdBy', 'updatedBy'
        ]) &&
        data.id == recordId &&
        data.month is string && data.month.size() > 0 && data.month.size() <= 40 &&
        data.year is int && data.year >= 2000 && data.year <= 2200 &&
        data.monthIndex is int && data.monthIndex >= 0 && data.monthIndex <= 11 &&
        data.status in ['OPEN', 'CLOSED'] &&
        data.openedAt is string && data.openedAt.size() > 0 && data.openedAt.size() <= 40 &&
        (data.closedAt == null || (data.closedAt is string && data.closedAt.size() <= 40)) &&
        data.openedBy == 'LANDLORD' &&
        data.workspaceId is string && data.workspaceId.size() > 0 && data.workspaceId.size() <= 120 &&
        data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128 &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    function isValidTenantCycle(data, recordId) {
      return data.keys().hasAll([
          'tenantId', 'cycleId', 'tenantName', 'houseId', 'expectedRent', 'expectedWater',
          'paidRent', 'paidWater', 'status', 'createdAt', 'workspaceId', 'createdBy'
        ]) &&
        data.keys().hasOnly([
          'tenantId', 'cycleId', 'tenantName', 'houseId', 'expectedRent', 'expectedWater',
          'paidRent', 'paidWater', 'status', 'createdAt', 'workspaceId', 'createdBy', 'updatedBy'
        ]) &&
        data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128 &&
        data.cycleId is string && data.cycleId.size() > 0 && data.cycleId.size() <= 128 &&
        recordId == data.tenantId + '_' + data.cycleId &&
        data.tenantName is string && data.tenantName.size() > 0 && data.tenantName.size() <= 120 &&
        data.houseId is string && data.houseId.size() <= 150 &&
        data.expectedRent is number && data.expectedRent >= 0 && data.expectedRent <= 1000000000000 &&
        data.expectedWater is number && data.expectedWater >= 0 && data.expectedWater <= 1000000000000 &&
        data.paidRent is number && data.paidRent >= 0 && data.paidRent <= 1000000000000 &&
        data.paidWater is number && data.paidWater >= 0 && data.paidWater <= 1000000000000 &&
        data.status in ['OPEN', 'CLEARED', 'ARREARS'] &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 40 &&
        data.workspaceId is string && data.workspaceId.size() > 0 && data.workspaceId.size() <= 120 &&
        data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128 &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    function tenantCycleStatusMatchesBalances(data) {
      let rentDue = data.expectedRent - data.paidRent;
      let waterDue = data.expectedWater - data.paidWater;
      let hasPayments = data.paidRent > 0 || data.paidWater > 0;
      return ((rentDue <= 0 && waterDue <= 0) && data.status == 'CLEARED') ||
        ((rentDue > 0 || waterDue > 0) && hasPayments && data.status == 'ARREARS') ||
        ((rentDue > 0 || waterDue > 0) && !hasPayments && data.status == 'OPEN');
    }

    function isValidTenantPricing(data) {
      return (!('expectedRent' in data) ||
          (data.expectedRent is number && data.expectedRent >= 0 && data.expectedRent <= 1000000000000)) &&
        (!('depositAmount' in data) ||
          ('expectedRent' in data && data.depositAmount is number && data.depositAmount == data.expectedRent)) &&
        (!('expectedWater' in data) ||
          (data.expectedWater is number && data.expectedWater >= 0 && data.expectedWater <= 1000000000000));
    }

    function tenantRentMatchesUnit(appId, data) {
      let housePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/houses/$(data.houseId);
      return data.houseId is string && data.houseId.size() > 0 && data.houseId.size() <= 150 &&
        existsAfter(housePath) && getAfter(housePath).data.rent is number &&
        data.expectedRent == getAfter(housePath).data.rent &&
        (sameWorkspace(getAfter(housePath).data) ||
          (isLegacyLandlord() && legacyRecord(getAfter(housePath).data)));
    }

    function isValidTenantLeaseCreate(appId, data) {
      return data.keys().hasAll(['houseId', 'expectedRent', 'depositAmount']) &&
        isValidTenantPricing(data) && tenantRentMatchesUnit(appId, data);
    }

    function tenantPricingUpdateIsValid(appId) {
      let data = request.resource.data;
      let rentOrHouseChanged = data.diff(resource.data).affectedKeys().hasAny([
        'expectedRent', 'depositAmount', 'houseId'
      ]);
      // Balance-only updates (payments and reset) preserve legacy lease fields
      // as-is. Validate the unit/rent/deposit invariant only when those fields
      // are actually changed.
      return !rentOrHouseChanged ||
        (isValidTenantPricing(data) &&
          data.keys().hasAll(['houseId', 'expectedRent', 'depositAmount']) &&
          tenantRentMatchesUnit(appId, data));
    }

    function isCycleCollection(collectionName) {
      return collectionName in ['billingCycles', 'tenantCycles'];
    }

    function validTenantCycleCreate(appId, data, recordId) {
      let billingCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/billingCycles/$(data.cycleId);
      return isValidTenantCycle(data, recordId) &&
        existsAfter(billingCyclePath) &&
        getAfter(billingCyclePath).data.status == 'OPEN' &&
        sameWorkspace(getAfter(billingCyclePath).data);
    }

    function tenantCycleParentIsOpen(appId, data) {
      let billingCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/billingCycles/$(data.cycleId);
      return exists(billingCyclePath) && get(billingCyclePath).data.status == 'OPEN' &&
        sameWorkspace(get(billingCyclePath).data);
    }

    function tenantCycleResetIsValid(appId, recordId) {
      let before = resource.data;
      let data = request.resource.data;
      let billingCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/billingCycles/$(data.cycleId);
      let chargesExist = data.expectedRent > 0 || data.expectedWater > 0;
      return data.keys().hasAll([
          'tenantId', 'cycleId', 'expectedRent', 'expectedWater', 'paidRent',
          'paidWater', 'status', 'workspaceId'
        ]) &&
        data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128 &&
        data.cycleId is string && data.cycleId.size() > 0 && data.cycleId.size() <= 128 &&
        recordId == data.tenantId + '_' + data.cycleId &&
        data.expectedRent is number && data.expectedRent >= 0 && data.expectedRent <= 1000000000000 &&
        data.expectedWater is number && data.expectedWater >= 0 && data.expectedWater <= 1000000000000 &&
        data.paidRent is number && data.paidRent == 0 &&
        data.paidWater is number && data.paidWater == 0 &&
        data.workspaceId is string && data.workspaceId.size() > 0 && data.workspaceId.size() <= 120 &&
        data.updatedBy == request.auth.uid &&
        exists(billingCyclePath) && sameWorkspace(get(billingCyclePath).data) &&
        data.diff(before).affectedKeys().hasOnly(['paidRent', 'paidWater', 'status', 'updatedBy']) &&
        ((get(billingCyclePath).data.status == 'OPEN' &&
            ((chargesExist && data.status == 'OPEN') || (!chargesExist && data.status == 'CLEARED'))) ||
         (get(billingCyclePath).data.status == 'CLOSED' &&
            ((chargesExist && data.status == 'ARREARS') || (!chargesExist && data.status == 'CLEARED'))));
    }

    function managerPaymentCreateIsPending(appId) {
      return isValidPayment(request.resource.data) &&
        !('updatedBy' in request.resource.data) &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.loggedBy == 'MANAGER' &&
        paymentCycleIsOpen(appId, request.resource.data);
    }

    function managerCanUpdateRecord(collectionName, appId, recordId) {
      return (collectionName == 'houses' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repairStatus', 'updatedBy']) &&
          request.resource.data.repairStatus in ['GOOD', 'NEEDS_REPAIR']) ||
        (collectionName == 'repairs' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cost', 'resolvedAt', 'updatedBy']) &&
          request.resource.data.status == 'RESOLVED' &&
          request.resource.data.cost is number && request.resource.data.cost >= 0 && request.resource.data.cost <= 1000000000000 &&
          request.resource.data.resolvedAt is string && request.resource.data.resolvedAt.size() <= 40) ||
        (collectionName == 'tenantCycles' &&
          isValidTenantCycle(request.resource.data, recordId) &&
          tenantCycleParentIsOpen(appId, request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expectedWater', 'status', 'updatedBy']) &&
          tenantCycleStatusMatchesBalances(request.resource.data));
    }

    function isValidCollectionCreate(collectionName, appId, data, recordId) {
      return (collectionName == 'payments' && isValidPayment(data) &&
          !('updatedBy' in data) && paymentCycleIsOpen(appId, data)) ||
        (collectionName == 'billingCycles' && isValidBillingCycle(data, recordId)) ||
        (collectionName == 'tenantCycles' && validTenantCycleCreate(appId, data, recordId)) ||
        (collectionName == 'tenants' && isValidTenantLeaseCreate(appId, data)) ||
        (!isCycleCollection(collectionName) && collectionName != 'payments' && collectionName != 'tenants');
    }

    function cycleUpdateIsValid(collectionName, appId, recordId) {
      return (collectionName != 'billingCycles' && collectionName != 'tenantCycles' && collectionName != 'payments') ||
        (collectionName == 'billingCycles' &&
          isValidBillingCycle(request.resource.data, recordId) &&
          resource.data.status == 'OPEN' && request.resource.data.status == 'CLOSED' &&
          request.resource.data.closedAt is string &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt', 'updatedBy'])) ||
        (collectionName == 'tenantCycles' &&
          isValidTenantCycle(request.resource.data, recordId) &&
          tenantCycleParentIsOpen(appId, request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'tenantName', 'houseId', 'expectedRent', 'expectedWater', 'paidRent',
            'paidWater', 'status', 'updatedBy'
          ])) ||
        (collectionName == 'payments' &&
          isValidPayment(request.resource.data) &&
          resource.data.status == 'PENDING' && request.resource.data.status == 'CONFIRMED' &&
          request.resource.data.updatedBy == request.auth.uid &&
          paymentCycleIsOpen(appId, request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'appliedRent', 'appliedWater', 'excessAmount', 'updatedBy'
          ]));
    }

    match /users/{userId} {
      // Role profiles can contain private identity data. A landlord may only read profiles in their workspace.
      allow read: if signedIn() && (request.auth.uid == userId ||
        (isLandlord() && hasProfile() &&
          get(/databases/$(database)/documents/users/$(userId)).data.workspaceId is string &&
          profile().workspaceId is string &&
          get(/databases/$(database)/documents/users/$(userId)).data.workspaceId == profile().workspaceId));

      // Only an already-authorized landlord may provision or update manager profiles.
      allow create, update: if isLandlord() &&
        request.resource.data.role == 'MANAGER' &&
        request.resource.data.workspaceId is string &&
        (isLegacyLandlord()
          ? request.resource.data.workspaceId == 'main-workspace'
          : (hasProfile() && request.resource.data.workspaceId == profile().workspaceId));

      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/{collectionName}/{recordId} {
      // Compatibility reads preserve the existing UID-based accounts while they migrate.
      allow read: if isLegacyLandlord() ||
        (isLegacyManager() && managerCollectionAllowed(collectionName)) ||
        (isLandlord() && sameWorkspace(resource.data)) ||
        (isManager() && managerCollectionAllowed(collectionName) && sameWorkspace(resource.data));

      allow create: if isLandlord() &&
        sameWorkspace(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidCollectionCreate(collectionName, appId, request.resource.data, recordId);

      allow create: if isManager() &&
        managerCanCreate(collectionName) &&
        sameWorkspace(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid &&
        !isCycleCollection(collectionName) &&
        (collectionName != 'payments' || managerPaymentCreateIsPending(appId));

      allow update: if isLandlord() &&
        (sameWorkspace(resource.data) || (isLegacyLandlord() && legacyRecord(resource.data))) &&
        (sameWorkspace(request.resource.data) || (isLegacyLandlord() && legacyRecord(request.resource.data))) &&
        request.resource.data.updatedBy == request.auth.uid &&
        (collectionName != 'tenants' || tenantPricingUpdateIsValid(appId)) &&
        (cycleUpdateIsValid(collectionName, appId, recordId) ||
          (collectionName == 'tenantCycles' && tenantCycleResetIsValid(appId, recordId)));

      allow update: if isManager() &&
        managerCollectionAllowed(collectionName) &&
        collectionName != 'billingCycles' &&
        (sameWorkspace(resource.data) || (isLegacyManager() && legacyRecord(resource.data))) &&
        (sameWorkspace(request.resource.data) || (isLegacyManager() && legacyRecord(request.resource.data))) &&
        request.resource.data.updatedBy == request.auth.uid &&
        cycleUpdateIsValid(collectionName, appId, recordId) &&
        managerCanUpdateRecord(collectionName, appId, recordId);

      allow delete: if isLandlord() &&
        collectionName in ['payments', 'paymentReferences', 'repairs', 'septicLogs', 'masterWaterBills'] &&
        (sameWorkspace(resource.data) || (isLegacyLandlord() && legacyRecord(resource.data)));
    }
  }
}
