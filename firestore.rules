rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed data model: app records live under artifacts/{appId}/public/data/{collection}/{id}.
    // payments: tenant/cycle IDs, amount allocations, type/method/reference, status, date, actor and workspace.
    // billingCycles: mirrored ID, month/year/index, OPEN/CLOSED state, timestamps, actor and workspace.
    // tenantCycles: tenant/cycle IDs, expected/paid rent and water, status, creation actor/time and workspace.
    // Other operational collections retain the existing app schema and workspace/actor checks.

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    // Temporary compatibility bridge for the three existing production accounts.
    function isLegacyLandlord() {
      return signedIn() && request.auth.uid == 'b4HMBcL0WXT3Qg2vunj5ITZOVb72';
    }

    function isLegacyManager() {
      return signedIn() && request.auth.uid in [
        'CG6wl2NaTcdLHyGlXHk4w9eCU653',
        'N8wEpIJvUZRmD6WoYYxqpUiiLhj2'
      ];
    }

    function isLegacyAccount() {
      return isLegacyLandlord() || isLegacyManager();
    }

    function profile() {
      return get(profilePath()).data;
    }

    function roleSourcesAgree(roleName) {
      return (!('role' in request.auth.token) || request.auth.token.role == roleName) &&
        (!hasProfile() || !('role' in profile()) || profile().role == roleName);
    }

    function isLandlord() {
      return signedIn() && roleSourcesAgree('LANDLORD') && (
        request.auth.token.role == 'LANDLORD' ||
        isLegacyLandlord() ||
        (hasProfile() && profile().role == 'LANDLORD')
      );
    }

    function isManager() {
      return signedIn() &&
        roleSourcesAgree('MANAGER') &&
        (!hasProfile() || !('disabled' in profile()) || profile().disabled != true) && (
        request.auth.token.role == 'MANAGER' ||
        isLegacyManager() ||
        (hasProfile() && profile().role == 'MANAGER')
      );
    }

    function sameWorkspace(data) {
      return data.workspaceId is string && (
        (hasProfile() && profile().workspaceId is string && data.workspaceId == profile().workspaceId) ||
        (isLegacyAccount() && data.workspaceId == 'main-workspace')
      );
    }

    function legacyRecord(data) {
      return isLegacyAccount() && (!(data.workspaceId is string) || data.workspaceId == 'main-workspace');
    }

    function notificationWriteIsWorkspaceScoped(before, after) {
      return notificationRecordWorkspaceScoped(before) && notificationRecordWorkspaceScoped(after);
    }

    function notificationRecordWorkspaceScoped(data) {
      return sameWorkspace(data) ||
        (isLegacyAccount() &&
          (!('workspaceId' in data) || (data.workspaceId is string && data.workspaceId == 'main-workspace')));
    }

    function managerCollectionAllowed(collectionName) {
      return collectionName in [
        'houses', 'tenants', 'payments', 'repairs', 'septicLogs', 'garbageLogs', 'masterWaterBills',
        'billingCycles', 'tenantCycles', 'expenses', 'notifications', 'paymentReferences'
      ];
    }

    function managerCanCreate(collectionName) {
      return collectionName in [
        'payments', 'repairs', 'septicLogs', 'garbageLogs', 'masterWaterBills', 'expenses',
        'notifications', 'paymentReferences', 'auditLogs', 'tenantChangeRequests'
      ];
    }

    function paymentCycleIsOpen(appId, paymentData) {
      let tenantCycleId = paymentData.tenantId + '_' + paymentData.cycleId;
      let billingCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/billingCycles/$(paymentData.cycleId);
      let tenantCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenantCycles/$(tenantCycleId);
      let tenantPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenants/$(paymentData.tenantId);
      return exists(billingCyclePath) &&
        get(billingCyclePath).data.status == 'OPEN' &&
        sameWorkspace(get(billingCyclePath).data) &&
        exists(tenantPath) &&
        sameWorkspace(get(tenantPath).data) &&
        exists(tenantCyclePath) &&
        get(tenantCyclePath).data.tenantId == paymentData.tenantId &&
        get(tenantCyclePath).data.cycleId == paymentData.cycleId &&
        sameWorkspace(get(tenantCyclePath).data);
    }

    function paymentCycleAllowsLandlord(appId, paymentData) {
      let tenantCycleId = paymentData.tenantId + '_' + paymentData.cycleId;
      let billingCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/billingCycles/$(paymentData.cycleId);
      let tenantCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenantCycles/$(tenantCycleId);
      let tenantPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenants/$(paymentData.tenantId);
      return isLandlord() && paymentData.loggedBy == 'LANDLORD' &&
        existsAfter(billingCyclePath) &&
        getAfter(billingCyclePath).data.status in ['OPEN', 'CLOSED'] &&
        sameWorkspace(getAfter(billingCyclePath).data) &&
        exists(tenantPath) && sameWorkspace(get(tenantPath).data) &&
        existsAfter(tenantCyclePath) &&
        getAfter(tenantCyclePath).data.tenantId == paymentData.tenantId &&
        getAfter(tenantCyclePath).data.cycleId == paymentData.cycleId &&
        sameWorkspace(getAfter(tenantCyclePath).data);
    }

    function isValidPayment(data) {
      return data.keys().hasAll([
          'tenantId', 'tenantName', 'amount', 'appliedRent', 'appliedWater', 'excessAmount',
          'type', 'method', 'messageCode', 'status', 'date', 'loggedBy', 'cycleId', 'workspaceId', 'createdBy'
        ]) &&
        data.keys().hasOnly([
          'tenantId', 'tenantName', 'amount', 'appliedRent', 'appliedWater', 'excessAmount',
          'type', 'method', 'messageCode', 'status', 'date', 'loggedBy', 'cycleId', 'workspaceId', 'createdBy', 'updatedBy'
        ]) &&
        data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128 &&
        data.tenantName is string && data.tenantName.size() > 0 && data.tenantName.size() <= 120 &&
        data.amount is number && data.amount > 0 && data.amount <= 1000000000000 &&
        data.appliedRent is number && data.appliedRent >= 0 && data.appliedRent <= data.amount &&
        data.appliedWater is number && data.appliedWater >= 0 && data.appliedWater <= data.amount &&
        data.excessAmount is number && data.excessAmount >= 0 && data.excessAmount <= data.amount &&
        data.type in ['RENT', 'WATER', 'COMBINED'] &&
        data.method is string && data.method.size() > 0 && data.method.size() <= 40 &&
        !data.method.matches('(?i)^cash$') &&
        data.messageCode is string && data.messageCode.size() <= 100 && data.messageCode != 'N/A' &&
        data.status in ['PENDING', 'CONFIRMED'] &&
        data.date is string && data.date.size() > 0 && data.date.size() <= 40 &&
        data.loggedBy in ['LANDLORD', 'MANAGER'] &&
        data.cycleId is string && data.cycleId.size() > 0 && data.cycleId.size() <= 128 &&
        data.workspaceId is string && data.workspaceId.size() > 0 && data.workspaceId.size() <= 120 &&
        data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128 &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128)) &&
        ((data.status == 'PENDING' && data.loggedBy == 'MANAGER' &&
          data.appliedRent == 0 && data.appliedWater == 0 && data.excessAmount == 0) ||
         (data.status == 'CONFIRMED' && data.messageCode.size() > 0 &&
          math.abs(data.amount - data.appliedRent - data.appliedWater - data.excessAmount) <= 0.01));
    }

    function isValidBillingCycle(data, recordId) {
      return data.keys().hasAll([
          'id', 'month', 'year', 'monthIndex', 'status', 'openedAt', 'closedAt',
          'openedBy', 'workspaceId', 'createdBy'
        ]) &&
        data.keys().hasOnly([
          'id', 'month', 'year', 'monthIndex', 'status', 'openedAt', 'closedAt',
          'openedBy', 'workspaceId', 'createdBy', 'updatedBy'
        ]) &&
        data.id == recordId &&
        data.month is string && data.month.size() > 0 && data.month.size() <= 40 &&
        data.year is int && data.year >= 2000 && data.year <= 2200 &&
        data.monthIndex is int && data.monthIndex >= 0 && data.monthIndex <= 11 &&
        data.status in ['OPEN', 'CLOSED'] &&
        data.openedAt is string && data.openedAt.size() > 0 && data.openedAt.size() <= 40 &&
        (data.closedAt == null || (data.closedAt is string && data.closedAt.size() <= 40)) &&
        data.openedBy == 'LANDLORD' &&
        data.workspaceId is string && data.workspaceId.size() > 0 && data.workspaceId.size() <= 120 &&
        data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128 &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    function isValidTenantCycle(data, recordId) {
      return data.keys().hasAll([
          'tenantId', 'cycleId', 'tenantName', 'houseId', 'expectedRent', 'expectedWater',
          'paidRent', 'paidWater', 'status', 'createdAt', 'workspaceId', 'createdBy'
        ]) &&
        data.keys().hasOnly([
          'tenantId', 'cycleId', 'tenantName', 'houseId', 'expectedRent', 'expectedWater',
          'paidRent', 'paidWater', 'status', 'createdAt', 'workspaceId', 'createdBy', 'updatedBy', 'updatedAt'
        ]) &&
        data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128 &&
        data.cycleId is string && data.cycleId.size() > 0 && data.cycleId.size() <= 128 &&
        recordId == data.tenantId + '_' + data.cycleId &&
        data.tenantName is string && data.tenantName.size() > 0 && data.tenantName.size() <= 120 &&
        data.houseId is string && data.houseId.size() <= 150 &&
        data.expectedRent is number && data.expectedRent >= 0 && data.expectedRent <= 1000000000000 &&
        data.expectedWater is number && data.expectedWater >= 0 && data.expectedWater <= 1000000000000 &&
        data.paidRent is number && data.paidRent >= 0 && data.paidRent <= 1000000000000 &&
        data.paidWater is number && data.paidWater >= 0 && data.paidWater <= 1000000000000 &&
        data.status in ['OPEN', 'CLEARED', 'ARREARS'] &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 40 &&
        data.workspaceId is string && data.workspaceId.size() > 0 && data.workspaceId.size() <= 120 &&
        data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128 &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 40));
    }

    function tenantCycleStatusMatchesBalances(data) {
      let rentDue = data.expectedRent - data.paidRent;
      let waterDue = data.expectedWater - data.paidWater;
      let hasPayments = data.paidRent > 0 || data.paidWater > 0;
      return ((rentDue <= 0 && waterDue <= 0) && data.status == 'CLEARED') ||
        ((rentDue > 0 || waterDue > 0) && hasPayments && data.status == 'ARREARS') ||
        ((rentDue > 0 || waterDue > 0) && !hasPayments && data.status == 'OPEN');
    }

    function isValidTenantPricing(data) {
      return (!('expectedRent' in data) ||
          (data.expectedRent is number && data.expectedRent >= 0 && data.expectedRent <= 1000000000000)) &&
        (!('depositAmount' in data) ||
          ('expectedRent' in data && data.depositAmount is number && data.depositAmount == data.expectedRent)) &&
        (!('expectedWater' in data) ||
          (data.expectedWater is number && data.expectedWater >= 0 && data.expectedWater <= 1000000000000));
    }

    function tenantRentMatchesUnit(appId, data) {
      let housePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/houses/$(data.houseId);
      return data.houseId is string && data.houseId.size() > 0 && data.houseId.size() <= 150 &&
        existsAfter(housePath) && getAfter(housePath).data.rent is number &&
        data.expectedRent == getAfter(housePath).data.rent &&
        (sameWorkspace(getAfter(housePath).data) ||
          (isLegacyLandlord() && legacyRecord(getAfter(housePath).data)));
    }

    function isValidTenantLeaseCreate(appId, data) {
      return data.keys().hasAll(['houseId', 'expectedRent', 'depositAmount']) &&
        isValidTenantPricing(data) && tenantRentMatchesUnit(appId, data);
    }

    function isValidTenantChangeRequestCreate(appId, data) {
      let tenantPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenants/$(data.tenantId);
      let housePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/houses/$(data.houseId);
      return data.keys().hasAll([
          'action', 'status', 'tenantId', 'tenantName', 'phone', 'contactPref', 'houseId',
          'requestedByName', 'requestedAt', 'workspaceId', 'createdBy', 'updatedBy'
        ]) &&
        data.keys().hasOnly([
          'action', 'status', 'tenantId', 'tenantName', 'phone', 'contactPref', 'houseId',
          'requestedByName', 'requestedAt', 'workspaceId', 'createdBy', 'updatedBy',
          'requestedName', 'requestedPhone', 'requestedContactPref', 'activeCycleId',
          'cycleId', 'currentExpectedRent', 'currentExpectedWater',
          'requestedExpectedRent', 'requestedExpectedWater'
        ]) &&
        data.status == 'PENDING' &&
        data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128 &&
        data.tenantName is string && data.tenantName.size() > 0 && data.tenantName.size() <= 120 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.contactPref is string && data.contactPref.size() <= 40 &&
        data.houseId is string && data.houseId.size() <= 150 &&
        data.requestedByName is string && data.requestedByName.size() > 0 && data.requestedByName.size() <= 120 &&
        data.requestedAt is string && data.requestedAt.size() > 0 && data.requestedAt.size() <= 40 &&
        data.workspaceId is string && data.workspaceId.size() > 0 && data.workspaceId.size() <= 120 &&
        data.createdBy == request.auth.uid && data.updatedBy == request.auth.uid &&
        ((data.action == 'CREATE_TENANT' &&
            data.keys().hasOnly([
              'action', 'status', 'tenantId', 'tenantName', 'phone', 'contactPref', 'houseId',
              'requestedByName', 'requestedAt', 'workspaceId', 'createdBy', 'updatedBy'
            ]) &&
            data.phone.size() > 0 && data.contactPref.size() > 0 && data.houseId.size() > 0 &&
            !exists(tenantPath) && exists(housePath) && get(housePath).data.status == 'VACANT' &&
            sameWorkspace(get(housePath).data)) ||
         (data.action == 'DELETE_TENANT' && exists(tenantPath) &&
            data.keys().hasOnly([
              'action', 'status', 'tenantId', 'tenantName', 'phone', 'contactPref', 'houseId',
              'requestedByName', 'requestedAt', 'workspaceId', 'createdBy', 'updatedBy'
            ]) &&
            (sameWorkspace(get(tenantPath).data) || (isLegacyManager() && legacyRecord(get(tenantPath).data))) &&
            (!('status' in get(tenantPath).data) || get(tenantPath).data.status != 'ARCHIVED') &&
            !('archivedAt' in get(tenantPath).data) &&
            data.tenantName == get(tenantPath).data.name &&
            data.houseId == (get(tenantPath).data.houseId is string ? get(tenantPath).data.houseId : '')) ||
         (data.action == 'UPDATE_TENANT' &&
            isValidTenantUpdateRequestCreate(appId, data)) ||
         (data.action == 'UPDATE_TENANT_BILL' &&
            isValidTenantBillUpdateRequestCreate(appId, data)));
    }

    function isValidTenantUpdateRequestCreate(appId, data) {
      let tenantPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenants/$(data.tenantId);
      let housePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/houses/$(data.houseId);
      return data.keys().hasAll(['requestedName', 'requestedPhone', 'requestedContactPref', 'activeCycleId']) &&
        data.keys().hasOnly([
          'action', 'status', 'tenantId', 'tenantName', 'phone', 'contactPref', 'houseId',
          'requestedByName', 'requestedAt', 'workspaceId', 'createdBy', 'updatedBy',
          'requestedName', 'requestedPhone', 'requestedContactPref', 'activeCycleId'
        ]) &&
        data.requestedName is string && data.requestedName.size() > 0 && data.requestedName.size() <= 120 &&
        data.requestedPhone is string && data.requestedPhone.size() <= 40 &&
        data.requestedContactPref is string && data.requestedContactPref.size() <= 40 &&
        data.activeCycleId is string && data.activeCycleId.size() <= 128 &&
        exists(tenantPath) &&
        (sameWorkspace(get(tenantPath).data) || (isLegacyManager() && legacyRecord(get(tenantPath).data))) &&
        data.workspaceId == (get(tenantPath).data.workspaceId is string
          ? get(tenantPath).data.workspaceId
          : 'main-workspace') &&
        get(tenantPath).data.name is string &&
        data.tenantName == get(tenantPath).data.name &&
        data.phone == (get(tenantPath).data.phone is string ? get(tenantPath).data.phone : '') &&
        data.contactPref == (get(tenantPath).data.contactPref is string ? get(tenantPath).data.contactPref : '') &&
        get(tenantPath).data.houseId is string && get(tenantPath).data.houseId.size() > 0 &&
        data.houseId == get(tenantPath).data.houseId &&
        (!('status' in get(tenantPath).data) || get(tenantPath).data.status == 'ACTIVE') &&
        !('archivedAt' in get(tenantPath).data) &&
        exists(housePath) && get(housePath).data.status == 'OCCUPIED' &&
        (sameWorkspace(get(housePath).data) || (isLegacyManager() && legacyRecord(get(housePath).data))) &&
        tenantUpdateRequestCycleIsValid(appId, data);
    }

    function tenantUpdateRequestCycleIsValid(appId, data) {
      return data.activeCycleId == '' || tenantUpdateRequestCycleIsValidForId(appId, data);
    }

    function tenantUpdateRequestCycleIsValidForId(appId, data) {
      let billingCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/billingCycles/$(data.activeCycleId);
      let tenantCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenantCycles/$(data.tenantId + '_' + data.activeCycleId);
      return data.activeCycleId.size() > 0 &&
        exists(billingCyclePath) && get(billingCyclePath).data.status == 'OPEN' &&
        (sameWorkspace(get(billingCyclePath).data) || (isLegacyManager() && legacyRecord(get(billingCyclePath).data))) &&
        (!exists(tenantCyclePath) ||
          (get(tenantCyclePath).data.tenantId == data.tenantId &&
            get(tenantCyclePath).data.cycleId == data.activeCycleId &&
            get(tenantCyclePath).data.tenantName == data.tenantName &&
            (!('workspaceId' in get(tenantCyclePath).data) || get(tenantCyclePath).data.workspaceId == data.workspaceId) &&
            (sameWorkspace(get(tenantCyclePath).data) || (isLegacyManager() && legacyRecord(get(tenantCyclePath).data)))));
    }

    function isValidTenantBillUpdateRequestCreate(appId, data) {
      let tenantPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenants/$(data.tenantId);
      let housePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/houses/$(data.houseId);
      let billingCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/billingCycles/$(data.cycleId);
      let tenantCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenantCycles/$(data.tenantId + '_' + data.cycleId);
      return data.keys().hasAll([
          'cycleId', 'currentExpectedRent', 'currentExpectedWater',
          'requestedExpectedRent', 'requestedExpectedWater'
        ]) &&
        data.keys().hasOnly([
          'action', 'status', 'tenantId', 'tenantName', 'phone', 'contactPref', 'houseId',
          'requestedByName', 'requestedAt', 'workspaceId', 'createdBy', 'updatedBy',
          'cycleId', 'currentExpectedRent', 'currentExpectedWater',
          'requestedExpectedRent', 'requestedExpectedWater'
        ]) &&
        data.cycleId is string && data.cycleId.size() > 0 && data.cycleId.size() <= 128 &&
        data.houseId is string && data.houseId.size() > 0 && data.houseId.size() <= 150 &&
        data.currentExpectedRent is number && data.currentExpectedRent >= 0 && data.currentExpectedRent <= 1000000000000 &&
        data.currentExpectedWater is number && data.currentExpectedWater >= 0 && data.currentExpectedWater <= 1000000000000 &&
        data.requestedExpectedRent is number && data.requestedExpectedRent >= 0 && data.requestedExpectedRent <= 1000000000000 &&
        data.requestedExpectedWater is number && data.requestedExpectedWater >= 0 && data.requestedExpectedWater <= 1000000000000 &&
        exists(tenantPath) &&
        (sameWorkspace(get(tenantPath).data) || (isLegacyManager() && legacyRecord(get(tenantPath).data))) &&
        data.workspaceId == (get(tenantPath).data.workspaceId is string
          ? get(tenantPath).data.workspaceId
          : 'main-workspace') &&
        get(tenantPath).data.name is string &&
        data.phone == (get(tenantPath).data.phone is string ? get(tenantPath).data.phone : '') &&
        data.contactPref == (get(tenantPath).data.contactPref is string ? get(tenantPath).data.contactPref : '') &&
        exists(housePath) &&
        (sameWorkspace(get(housePath).data) || (isLegacyManager() && legacyRecord(get(housePath).data))) &&
        exists(billingCyclePath) && get(billingCyclePath).data.id == data.cycleId &&
        get(billingCyclePath).data.status == 'CLOSED' &&
        (sameWorkspace(get(billingCyclePath).data) || (isLegacyManager() && legacyRecord(get(billingCyclePath).data))) &&
        exists(tenantCyclePath) && get(tenantCyclePath).data.tenantId == data.tenantId &&
        get(tenantCyclePath).data.cycleId == data.cycleId &&
        get(tenantCyclePath).data.tenantName == data.tenantName &&
        get(tenantCyclePath).data.houseId == data.houseId &&
        get(tenantCyclePath).data.expectedRent == data.currentExpectedRent &&
        get(tenantCyclePath).data.expectedWater == data.currentExpectedWater &&
        get(tenantCyclePath).data.expectedRent is number && get(tenantCyclePath).data.expectedWater is number &&
        get(tenantCyclePath).data.paidRent is number && get(tenantCyclePath).data.paidWater is number &&
        get(tenantCyclePath).data.paidRent >= 0 && get(tenantCyclePath).data.paidRent <= data.currentExpectedRent &&
        get(tenantCyclePath).data.paidWater >= 0 && get(tenantCyclePath).data.paidWater <= data.currentExpectedWater &&
        data.requestedExpectedRent >= get(tenantCyclePath).data.paidRent &&
        data.requestedExpectedWater >= get(tenantCyclePath).data.paidWater &&
        get(tenantCyclePath).data.status in ['CLEARED', 'ARREARS'] &&
        (!('workspaceId' in get(tenantCyclePath).data) || get(tenantCyclePath).data.workspaceId == data.workspaceId) &&
        (sameWorkspace(get(tenantCyclePath).data) || (isLegacyManager() && legacyRecord(get(tenantCyclePath).data)));
    }

    function documentIsUnchanged(path) {
      return (!exists(path) && !existsAfter(path)) ||
        (exists(path) && existsAfter(path) &&
          getAfter(path).data.diff(get(path).data).affectedKeys().hasOnly([]));
    }

    function tenantUpdateCycleIsUnchanged(appId, data) {
      return !('activeCycleId' in data) || data.activeCycleId == '' ||
        documentIsUnchanged(/databases/$(database)/documents/artifacts/$(appId)/public/data/tenantCycles/$(data.tenantId + '_' + data.activeCycleId));
    }

    function tenantChangeRequestRejectionEffectsMatch(appId, data) {
      let tenantPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenants/$(data.tenantId);
      let housePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/houses/$(data.houseId);
      return documentIsUnchanged(tenantPath) &&
        (data.houseId == '' || documentIsUnchanged(housePath)) &&
        (data.action != 'UPDATE_TENANT' || tenantUpdateCycleIsUnchanged(appId, data)) &&
        (data.action != 'UPDATE_TENANT_BILL' || tenantBillCycleIsUnchanged(appId, data));
    }

    function tenantBillCycleIsUnchanged(appId, data) {
      return documentIsUnchanged(/databases/$(database)/documents/artifacts/$(appId)/public/data/billingCycles/$(data.cycleId)) &&
        documentIsUnchanged(/databases/$(database)/documents/artifacts/$(appId)/public/data/tenantCycles/$(data.tenantId + '_' + data.cycleId));
    }

    function tenantChangeRequestApprovalEffectsMatch(appId, data) {
      let tenantPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenants/$(data.tenantId);
      let housePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/houses/$(data.houseId);
      return (data.action == 'CREATE_TENANT' &&
          existsAfter(tenantPath) && existsAfter(housePath) &&
          getAfter(tenantPath).data.status == 'ACTIVE' &&
          getAfter(tenantPath).data.name == data.tenantName &&
          getAfter(tenantPath).data.phone == data.phone &&
          getAfter(tenantPath).data.contactPref == data.contactPref &&
          getAfter(tenantPath).data.houseId == data.houseId &&
          getAfter(tenantPath).data.createdBy == request.auth.uid &&
          getAfter(tenantPath).data.workspaceId == data.workspaceId &&
          getAfter(tenantPath).data.expectedRent == getAfter(housePath).data.rent &&
          getAfter(housePath).data.status == 'OCCUPIED' &&
          getAfter(housePath).data.updatedBy == request.auth.uid &&
          sameWorkspace(getAfter(tenantPath).data) && sameWorkspace(getAfter(housePath).data)) ||
        (data.action == 'DELETE_TENANT' &&
          existsAfter(tenantPath) && getAfter(tenantPath).data.status == 'ARCHIVED' &&
          getAfter(tenantPath).data.archivedBy == request.auth.uid &&
          getAfter(tenantPath).data.updatedBy == request.auth.uid &&
          (sameWorkspace(getAfter(tenantPath).data) || (isLegacyLandlord() && legacyRecord(getAfter(tenantPath).data))) &&
          (data.houseId == '' ||
            (existsAfter(housePath) && getAfter(housePath).data.status == 'VACANT' &&
              getAfter(housePath).data.updatedBy == request.auth.uid &&
              (sameWorkspace(getAfter(housePath).data) || (isLegacyLandlord() && legacyRecord(getAfter(housePath).data)))))) ||
        (data.action == 'UPDATE_TENANT' && tenantUpdateApprovalEffectsMatch(appId, data)) ||
        (data.action == 'UPDATE_TENANT_BILL' && tenantBillUpdateApprovalEffectsMatch(appId, data));
    }

    function tenantBillUpdateApprovalEffectsMatch(appId, data) {
      let tenantPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenants/$(data.tenantId);
      let housePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/houses/$(data.houseId);
      let billingCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/billingCycles/$(data.cycleId);
      let tenantCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenantCycles/$(data.tenantId + '_' + data.cycleId);
      return isLandlord() &&
        data.cycleId is string && data.cycleId.size() > 0 && data.cycleId.size() <= 128 &&
        data.currentExpectedRent is number && data.currentExpectedRent >= 0 && data.currentExpectedRent <= 1000000000000 &&
        data.currentExpectedWater is number && data.currentExpectedWater >= 0 && data.currentExpectedWater <= 1000000000000 &&
        data.requestedExpectedRent is number && data.requestedExpectedRent >= 0 && data.requestedExpectedRent <= 1000000000000 &&
        data.requestedExpectedWater is number && data.requestedExpectedWater >= 0 && data.requestedExpectedWater <= 1000000000000 &&
        exists(tenantPath) &&
        (sameWorkspace(get(tenantPath).data) || (isLegacyLandlord() && legacyRecord(get(tenantPath).data))) &&
        data.workspaceId == (get(tenantPath).data.workspaceId is string
          ? get(tenantPath).data.workspaceId
          : 'main-workspace') &&
        data.phone == (get(tenantPath).data.phone is string ? get(tenantPath).data.phone : '') &&
        data.contactPref == (get(tenantPath).data.contactPref is string ? get(tenantPath).data.contactPref : '') &&
        exists(housePath) &&
        (sameWorkspace(get(housePath).data) || (isLegacyLandlord() && legacyRecord(get(housePath).data))) &&
        exists(billingCyclePath) && get(billingCyclePath).data.id == data.cycleId &&
        get(billingCyclePath).data.status == 'CLOSED' && existsAfter(billingCyclePath) &&
        getAfter(billingCyclePath).data.status == 'CLOSED' &&
        (sameWorkspace(get(billingCyclePath).data) || (isLegacyLandlord() && legacyRecord(get(billingCyclePath).data))) &&
        (sameWorkspace(getAfter(billingCyclePath).data) || (isLegacyLandlord() && legacyRecord(getAfter(billingCyclePath).data))) &&
        getAfter(billingCyclePath).data.diff(get(billingCyclePath).data).affectedKeys().hasOnly([]) &&
        exists(tenantCyclePath) && existsAfter(tenantCyclePath) &&
        tenantBillUpdateBeforeMatchesRequest(get(tenantCyclePath).data, data) &&
        tenantBillUpdateAfterMatchesRequest(getAfter(tenantCyclePath).data, get(tenantCyclePath).data, data) &&
        (sameWorkspace(get(tenantCyclePath).data) || (isLegacyLandlord() && legacyRecord(get(tenantCyclePath).data))) &&
        (sameWorkspace(getAfter(tenantCyclePath).data) || (isLegacyLandlord() && legacyRecord(getAfter(tenantCyclePath).data)));
    }

    function tenantBillUpdateBeforeMatchesRequest(bill, data) {
      return bill.tenantId == data.tenantId && bill.cycleId == data.cycleId &&
        bill.tenantName == data.tenantName && bill.houseId == data.houseId &&
        bill.expectedRent == data.currentExpectedRent && bill.expectedWater == data.currentExpectedWater &&
        bill.expectedRent is number && bill.expectedWater is number &&
        bill.paidRent is number && bill.paidWater is number &&
        bill.paidRent >= 0 && bill.paidRent <= bill.expectedRent &&
        bill.paidWater >= 0 && bill.paidWater <= bill.expectedWater &&
        data.requestedExpectedRent >= bill.paidRent &&
        data.requestedExpectedWater >= bill.paidWater &&
        bill.status in ['CLEARED', 'ARREARS'] &&
        (!('workspaceId' in bill) || bill.workspaceId == data.workspaceId);
    }

    function tenantBillUpdateAfterMatchesRequest(afterBill, beforeBill, data) {
      return afterBill.tenantId == data.tenantId && afterBill.cycleId == data.cycleId &&
        afterBill.tenantName == beforeBill.tenantName && afterBill.houseId == data.houseId &&
        afterBill.expectedRent == data.requestedExpectedRent &&
        afterBill.expectedWater == data.requestedExpectedWater &&
        afterBill.paidRent == beforeBill.paidRent && afterBill.paidWater == beforeBill.paidWater &&
        closedTenantCycleStatusMatchesBalances(afterBill) &&
        afterBill.updatedBy == request.auth.uid &&
        afterBill.updatedAt is string && afterBill.updatedAt.size() > 0 && afterBill.updatedAt.size() <= 40 &&
        afterBill.workspaceId == data.workspaceId &&
        afterBill.diff(beforeBill).affectedKeys().hasAll(['expectedRent', 'expectedWater']) &&
        afterBill.diff(beforeBill).affectedKeys().hasOnly([
          'expectedRent', 'expectedWater', 'status', 'updatedBy', 'updatedAt', 'workspaceId'
        ]);
    }

    function tenantUpdateCycleApprovalEffectsMatch(appId, data) {
      // Rules cannot query for every OPEN billing cycle. The request supplies the
      // cycle ID so this rule can validate the specific active cycle and row.
      return data.activeCycleId == '' || tenantUpdateCycleApprovalEffectsForId(appId, data);
    }

    function tenantUpdateCycleApprovalEffectsForId(appId, data) {
      let billingCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/billingCycles/$(data.activeCycleId);
      let tenantCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenantCycles/$(data.tenantId + '_' + data.activeCycleId);
      return data.activeCycleId.size() > 0 &&
        exists(billingCyclePath) && get(billingCyclePath).data.status == 'OPEN' &&
          (sameWorkspace(get(billingCyclePath).data) || (isLegacyLandlord() && legacyRecord(get(billingCyclePath).data))) &&
          existsAfter(billingCyclePath) && getAfter(billingCyclePath).data.status == 'OPEN' &&
          (sameWorkspace(getAfter(billingCyclePath).data) || (isLegacyLandlord() && legacyRecord(getAfter(billingCyclePath).data))) &&
          ((!exists(tenantCyclePath) && !existsAfter(tenantCyclePath)) ||
            (exists(tenantCyclePath) && existsAfter(tenantCyclePath) &&
              get(tenantCyclePath).data.tenantId == data.tenantId &&
              get(tenantCyclePath).data.cycleId == data.activeCycleId &&
              get(tenantCyclePath).data.tenantName == data.tenantName &&
              (!('workspaceId' in get(tenantCyclePath).data) || get(tenantCyclePath).data.workspaceId == data.workspaceId) &&
              (sameWorkspace(get(tenantCyclePath).data) || (isLegacyLandlord() && legacyRecord(get(tenantCyclePath).data))) &&
              getAfter(tenantCyclePath).data.tenantId == data.tenantId &&
              getAfter(tenantCyclePath).data.cycleId == data.activeCycleId &&
              getAfter(tenantCyclePath).data.tenantName == data.requestedName &&
              getAfter(tenantCyclePath).data.updatedBy == request.auth.uid &&
              getAfter(tenantCyclePath).data.workspaceId == data.workspaceId &&
              getAfter(tenantCyclePath).data.updatedAt is string &&
              getAfter(tenantCyclePath).data.updatedAt.size() > 0 && getAfter(tenantCyclePath).data.updatedAt.size() <= 40 &&
              (sameWorkspace(getAfter(tenantCyclePath).data) || (isLegacyLandlord() && legacyRecord(getAfter(tenantCyclePath).data))) &&
              getAfter(tenantCyclePath).data.diff(get(tenantCyclePath).data).affectedKeys().hasOnly([
                'tenantName', 'updatedBy', 'updatedAt', 'workspaceId'
              ])));
    }

    function tenantUpdateApprovalEffectsMatch(appId, data) {
      let tenantPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/tenants/$(data.tenantId);
      let housePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/houses/$(data.houseId);
      return data.action == 'UPDATE_TENANT' &&
        data.requestedName is string && data.requestedName.size() > 0 && data.requestedName.size() <= 120 &&
        data.requestedPhone is string && data.requestedPhone.size() <= 40 &&
        data.requestedContactPref is string && data.requestedContactPref.size() <= 40 &&
        data.activeCycleId is string && data.activeCycleId.size() <= 128 &&
        exists(tenantPath) && existsAfter(tenantPath) &&
        (sameWorkspace(get(tenantPath).data) || (isLegacyLandlord() && legacyRecord(get(tenantPath).data))) &&
        (sameWorkspace(getAfter(tenantPath).data) || (isLegacyLandlord() && legacyRecord(getAfter(tenantPath).data))) &&
        data.workspaceId == (get(tenantPath).data.workspaceId is string
          ? get(tenantPath).data.workspaceId
          : 'main-workspace') &&
        data.tenantName == get(tenantPath).data.name &&
        data.phone == (get(tenantPath).data.phone is string ? get(tenantPath).data.phone : '') &&
        data.contactPref == (get(tenantPath).data.contactPref is string ? get(tenantPath).data.contactPref : '') &&
        data.houseId == get(tenantPath).data.houseId &&
        (!('status' in get(tenantPath).data) || get(tenantPath).data.status == 'ACTIVE') &&
        !('archivedAt' in get(tenantPath).data) &&
        exists(housePath) && existsAfter(housePath) &&
        get(housePath).data.status == 'OCCUPIED' && getAfter(housePath).data.status == 'OCCUPIED' &&
        (sameWorkspace(get(housePath).data) || (isLegacyLandlord() && legacyRecord(get(housePath).data))) &&
        (sameWorkspace(getAfter(housePath).data) || (isLegacyLandlord() && legacyRecord(getAfter(housePath).data))) &&
        getAfter(housePath).data.diff(get(housePath).data).affectedKeys().hasOnly([]) &&
        getAfter(tenantPath).data.name == data.requestedName &&
        getAfter(tenantPath).data.phone == data.requestedPhone &&
        getAfter(tenantPath).data.contactPref == data.requestedContactPref &&
        getAfter(tenantPath).data.houseId == data.houseId &&
        getAfter(tenantPath).data.updatedBy == request.auth.uid &&
        getAfter(tenantPath).data.workspaceId == data.workspaceId &&
        getAfter(tenantPath).data.updatedAt is string &&
        getAfter(tenantPath).data.updatedAt.size() > 0 && getAfter(tenantPath).data.updatedAt.size() <= 40 &&
        getAfter(tenantPath).data.diff(get(tenantPath).data).affectedKeys().hasOnly([
          'name', 'phone', 'contactPref', 'updatedBy', 'updatedAt', 'workspaceId'
        ]) && tenantUpdateCycleApprovalEffectsMatch(appId, data);
    }

    function tenantChangeRequestUpdateIsValid(appId) {
      return isLandlord() && resource.data.status == 'PENDING' &&
        request.resource.data.status in ['APPROVED', 'REJECTED'] &&
        request.resource.data.reviewedAt is string && request.resource.data.reviewedAt.size() > 0 &&
        request.resource.data.reviewedAt.size() <= 40 &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedAt', 'reviewedBy', 'updatedBy'
        ]) &&
        (request.resource.data.status == 'REJECTED'
          ? tenantChangeRequestRejectionEffectsMatch(appId, resource.data)
          : tenantChangeRequestApprovalEffectsMatch(appId, resource.data));
    }

    function tenantPricingUpdateIsValid(appId) {
      let data = request.resource.data;
      let rentOrHouseChanged = data.diff(resource.data).affectedKeys().hasAny([
        'expectedRent', 'depositAmount', 'houseId'
      ]);
      // Balance-only updates (payments and reset) preserve legacy lease fields
      // as-is. Validate the unit/rent/deposit invariant only when those fields
      // are actually changed.
      return !rentOrHouseChanged ||
        (isValidTenantPricing(data) &&
          data.keys().hasAll(['houseId', 'expectedRent', 'depositAmount']) &&
          tenantRentMatchesUnit(appId, data));
    }

    function isCycleCollection(collectionName) {
      return collectionName in ['billingCycles', 'tenantCycles'];
    }

    function validTenantCycleCreate(appId, data, recordId) {
      let billingCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/billingCycles/$(data.cycleId);
      return isValidTenantCycle(data, recordId) &&
        existsAfter(billingCyclePath) &&
        getAfter(billingCyclePath).data.status == 'OPEN' &&
        sameWorkspace(getAfter(billingCyclePath).data);
    }

    function validHistoricalTenantCycleCreate(appId, data, recordId) {
      let billingCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/billingCycles/$(data.cycleId);
      return isLandlord() && isValidTenantCycle(data, recordId) &&
        existsAfter(billingCyclePath) &&
        getAfter(billingCyclePath).data.status == 'CLOSED' &&
        sameWorkspace(getAfter(billingCyclePath).data);
    }

    function tenantCycleParentIsOpen(appId, data) {
      let billingCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/billingCycles/$(data.cycleId);
      return exists(billingCyclePath) && get(billingCyclePath).data.status == 'OPEN' &&
        sameWorkspace(get(billingCyclePath).data);
    }

    function tenantCycleParentIsClosed(appId, data) {
      let billingCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/billingCycles/$(data.cycleId);
      return exists(billingCyclePath) && get(billingCyclePath).data.status == 'CLOSED' &&
        (sameWorkspace(get(billingCyclePath).data) ||
          (isLegacyLandlord() && legacyRecord(get(billingCyclePath).data)));
    }

    function closedTenantCycleStatusMatchesBalances(data) {
      let rentDue = data.expectedRent - data.paidRent;
      let waterDue = data.expectedWater - data.paidWater;
      return data.paidRent <= data.expectedRent && data.paidWater <= data.expectedWater &&
        (((rentDue <= 0 && waterDue <= 0) && data.status == 'CLEARED') ||
         ((rentDue > 0 || waterDue > 0) && data.status == 'ARREARS'));
    }

    function landlordClosedTenantCycleUpdateIsValid(appId, recordId) {
      let data = request.resource.data;
      return isLandlord() && isValidTenantCycle(data, recordId) &&
        tenantCycleParentIsClosed(appId, data) &&
        data.diff(resource.data).affectedKeys().hasOnly([
          'expectedRent', 'expectedWater', 'paidRent', 'paidWater', 'status',
          'updatedBy', 'updatedAt', 'workspaceId'
        ]) &&
        closedTenantCycleStatusMatchesBalances(data);
    }

    function tenantCycleResetIsValid(appId, recordId) {
      let before = resource.data;
      let data = request.resource.data;
      let billingCyclePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/billingCycles/$(data.cycleId);
      let chargesExist = data.expectedRent > 0 || data.expectedWater > 0;
      return data.keys().hasAll([
          'tenantId', 'cycleId', 'expectedRent', 'expectedWater', 'paidRent',
          'paidWater', 'status', 'workspaceId'
        ]) &&
        data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128 &&
        data.cycleId is string && data.cycleId.size() > 0 && data.cycleId.size() <= 128 &&
        recordId == data.tenantId + '_' + data.cycleId &&
        data.expectedRent is number && data.expectedRent >= 0 && data.expectedRent <= 1000000000000 &&
        data.expectedWater is number && data.expectedWater >= 0 && data.expectedWater <= 1000000000000 &&
        data.paidRent is number && data.paidRent == 0 &&
        data.paidWater is number && data.paidWater == 0 &&
        data.workspaceId is string && data.workspaceId.size() > 0 && data.workspaceId.size() <= 120 &&
        data.updatedBy == request.auth.uid &&
        exists(billingCyclePath) && sameWorkspace(get(billingCyclePath).data) &&
        data.diff(before).affectedKeys().hasOnly(['paidRent', 'paidWater', 'status', 'updatedBy']) &&
        ((get(billingCyclePath).data.status == 'OPEN' &&
            ((chargesExist && data.status == 'OPEN') || (!chargesExist && data.status == 'CLEARED'))) ||
         (get(billingCyclePath).data.status == 'CLOSED' &&
            ((chargesExist && data.status == 'ARREARS') || (!chargesExist && data.status == 'CLEARED'))));
    }

    function managerPaymentCreateIsPending(appId) {
      return isValidPayment(request.resource.data) &&
        !('updatedBy' in request.resource.data) &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.loggedBy == 'MANAGER' &&
        paymentCycleIsOpen(appId, request.resource.data);
    }

    function managerCanUpdateRecord(collectionName, appId, recordId) {
      return (collectionName == 'houses' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repairStatus', 'updatedBy']) &&
          request.resource.data.repairStatus in ['GOOD', 'NEEDS_REPAIR']) ||
        (collectionName == 'repairs' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cost', 'resolvedAt', 'updatedBy']) &&
          request.resource.data.status == 'RESOLVED' &&
          request.resource.data.cost is number && request.resource.data.cost >= 0 && request.resource.data.cost <= 1000000000000 &&
          request.resource.data.resolvedAt is string && request.resource.data.resolvedAt.size() <= 40) ||
        (collectionName == 'tenantCycles' &&
          isValidTenantCycle(request.resource.data, recordId) &&
          tenantCycleParentIsOpen(appId, request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expectedWater', 'status', 'updatedBy']) &&
          tenantCycleStatusMatchesBalances(request.resource.data));
    }

    function isValidGarbageLog(data) {
      return data.keys().hasAll([
          'provider', 'cost', 'date', 'notes', 'loggedBy', 'cycleId',
          'createdAt', 'workspaceId', 'createdBy', 'updatedBy'
        ]) &&
        data.keys().hasOnly([
          'provider', 'cost', 'date', 'notes', 'loggedBy', 'cycleId',
          'createdAt', 'workspaceId', 'createdBy', 'updatedBy'
        ]) &&
        data.provider is string && data.provider.size() > 0 && data.provider.size() <= 80 &&
        data.cost is number && data.cost >= 0 && data.cost <= 1000000000000 &&
        data.date is string && data.date.size() == 10 &&
        data.notes is string && data.notes.size() <= 300 &&
        data.loggedBy in ['LANDLORD', 'MANAGER'] &&
        (data.cycleId == null || (data.cycleId is string && data.cycleId.size() <= 128)) &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 40 &&
        data.workspaceId is string && data.workspaceId.size() > 0 && data.workspaceId.size() <= 120 &&
        data.createdBy == request.auth.uid && data.updatedBy == request.auth.uid;
    }

    function isValidCollectionCreate(collectionName, appId, data, recordId) {
      return (collectionName == 'payments' && isValidPayment(data) &&
          !('updatedBy' in data) && paymentCycleAllowsLandlord(appId, data)) ||
        (collectionName == 'garbageLogs' && isValidGarbageLog(data)) ||
        (collectionName == 'billingCycles' && isValidBillingCycle(data, recordId)) ||
        (collectionName == 'tenantCycles' &&
          (validTenantCycleCreate(appId, data, recordId) || validHistoricalTenantCycleCreate(appId, data, recordId))) ||
        (collectionName == 'tenants' && isValidTenantLeaseCreate(appId, data)) ||
        (!isCycleCollection(collectionName) && collectionName != 'payments' &&
          collectionName != 'tenants' && collectionName != 'tenantChangeRequests');
    }

    function cycleUpdateIsValid(collectionName, appId, recordId) {
      return (collectionName != 'billingCycles' && collectionName != 'tenantCycles' && collectionName != 'payments') ||
        (collectionName == 'billingCycles' &&
          isValidBillingCycle(request.resource.data, recordId) &&
          resource.data.status == 'OPEN' && request.resource.data.status == 'CLOSED' &&
          request.resource.data.closedAt is string &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt', 'updatedBy'])) ||
        (collectionName == 'tenantCycles' &&
          isValidTenantCycle(request.resource.data, recordId) &&
          tenantCycleParentIsOpen(appId, request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'tenantName', 'houseId', 'expectedRent', 'expectedWater', 'paidRent',
            'paidWater', 'status', 'updatedBy', 'updatedAt', 'workspaceId'
          ])) ||
        (collectionName == 'tenantCycles' && landlordClosedTenantCycleUpdateIsValid(appId, recordId)) ||
        (collectionName == 'payments' &&
          isValidPayment(request.resource.data) &&
          resource.data.status == 'PENDING' && request.resource.data.status == 'CONFIRMED' &&
          request.resource.data.updatedBy == request.auth.uid &&
          paymentCycleIsOpen(appId, request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'messageCode', 'appliedRent', 'appliedWater', 'excessAmount', 'updatedBy'
          ]));
    }

    match /users/{userId} {
      // Role profiles can contain private identity data. A landlord may only read profiles in their workspace.
      allow read: if signedIn() && (request.auth.uid == userId ||
        (isLandlord() && hasProfile() &&
          get(/databases/$(database)/documents/users/$(userId)).data.workspaceId is string &&
          profile().workspaceId is string &&
          get(/databases/$(database)/documents/users/$(userId)).data.workspaceId == profile().workspaceId));

      // Only an already-authorized landlord may provision or update manager profiles.
      allow create, update: if isLandlord() &&
        request.resource.data.role == 'MANAGER' &&
        request.resource.data.workspaceId is string &&
        (isLegacyLandlord()
          ? request.resource.data.workspaceId == 'main-workspace'
          : (hasProfile() && request.resource.data.workspaceId == profile().workspaceId));

      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/{collectionName}/{recordId} {
      // Legacy accounts still use unfiltered collection queries. Keep their temporary
      // compatibility access until the old records and queries are migrated to workspace filters.
      // Proposed tenant detail edits and bill changes remain landlord-only.
      allow read: if (collectionName == 'tenantChangeRequests' &&
          (isLegacyLandlord() || (isLandlord() && sameWorkspace(resource.data)) ||
            (isManager() && resource.data.createdBy == request.auth.uid &&
              resource.data.action in ['CREATE_TENANT', 'DELETE_TENANT', 'UPDATE_TENANT', 'UPDATE_TENANT_BILL'] &&
              (sameWorkspace(resource.data) || (isLegacyManager() && legacyRecord(resource.data)))))) ||
        (collectionName != 'tenantChangeRequests' &&
          (isLegacyLandlord() ||
            (isManager() && managerCollectionAllowed(collectionName) &&
              (isLegacyManager() || sameWorkspace(resource.data))) ||
            (isLandlord() && sameWorkspace(resource.data))));

      allow create: if isLandlord() &&
        sameWorkspace(request.resource.data) &&
        (collectionName != 'notifications' || sameWorkspace(request.resource.data)) &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidCollectionCreate(collectionName, appId, request.resource.data, recordId);

      allow create: if isManager() &&
        managerCanCreate(collectionName) &&
        sameWorkspace(request.resource.data) &&
        (collectionName != 'notifications' || sameWorkspace(request.resource.data)) &&
        request.resource.data.createdBy == request.auth.uid &&
        !isCycleCollection(collectionName) &&
        (collectionName != 'garbageLogs' || isValidGarbageLog(request.resource.data)) &&
        (collectionName != 'tenantChangeRequests' || isValidTenantChangeRequestCreate(appId, request.resource.data)) &&
        (collectionName != 'payments' || managerPaymentCreateIsPending(appId));

      allow update: if isLandlord() &&
        (sameWorkspace(resource.data) || (isLegacyLandlord() && legacyRecord(resource.data))) &&
        (sameWorkspace(request.resource.data) || (isLegacyLandlord() && legacyRecord(request.resource.data))) &&
        (collectionName != 'notifications' || notificationWriteIsWorkspaceScoped(resource.data, request.resource.data)) &&
        request.resource.data.updatedBy == request.auth.uid &&
        (collectionName != 'tenants' || tenantPricingUpdateIsValid(appId)) &&
        (collectionName != 'tenantChangeRequests' || tenantChangeRequestUpdateIsValid(appId)) &&
        (cycleUpdateIsValid(collectionName, appId, recordId) ||
          (collectionName == 'tenantCycles' && tenantCycleResetIsValid(appId, recordId)));

      allow update: if isManager() &&
        managerCollectionAllowed(collectionName) &&
        collectionName != 'tenants' &&
        collectionName != 'billingCycles' &&
        collectionName != 'tenantChangeRequests' &&
        (sameWorkspace(resource.data) || (isLegacyManager() && legacyRecord(resource.data))) &&
        (sameWorkspace(request.resource.data) || (isLegacyManager() && legacyRecord(request.resource.data))) &&
        (collectionName != 'notifications' || notificationWriteIsWorkspaceScoped(resource.data, request.resource.data)) &&
        request.resource.data.updatedBy == request.auth.uid &&
        cycleUpdateIsValid(collectionName, appId, recordId) &&
        managerCanUpdateRecord(collectionName, appId, recordId);

      allow delete: if isLandlord() &&
        collectionName in ['payments', 'paymentReferences', 'repairs', 'septicLogs', 'garbageLogs', 'masterWaterBills'] &&
        (sameWorkspace(resource.data) || (isLegacyLandlord() && legacyRecord(resource.data)));
    }
  }
}
